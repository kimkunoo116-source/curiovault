---
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
const currentPath = Astro.url.pathname;
---

<header class="bg-[#0b0f19] border-b border-slate-800/80 sticky top-0 z-50 backdrop-blur-md bg-opacity-95">
	<!-- Top Bar -->
	<div class="bg-[#070a12] border-b border-slate-900 text-slate-400 text-xs py-1.5 px-4">
		<div class="max-w-7xl mx-auto flex justify-between items-center">
			<div class="flex items-center gap-2">
				<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm bg-amber-500/10 text-amber-400 border border-amber-500/30 text-[10px] font-bold tracking-wider uppercase">
					<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
					DAILY WONDERS
				</span>
				<span class="hidden sm:inline text-slate-400 font-medium text-xs">
					{SITE_TAGLINE}
				</span>
			</div>
			<div class="flex items-center gap-3 text-xs text-slate-400">
				<span class="hidden md:inline">Curated Stories & Video Features</span>
				<span class="text-slate-500">&bull;</span>
				<span class="text-amber-400 font-medium">US Edition</span>
			</div>
		</div>
	</div>

	<!-- Main Navigation Bar -->
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-16 sm:h-20">
			<!-- Redesigned Premium Logo -->
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-3 group text-decoration-none">
					<!-- Geometric Isometric Vault Aperture Icon -->
					<div class="relative w-11 h-11 rounded-xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-700 p-0.5 shadow-lg shadow-amber-500/20 group-hover:shadow-amber-500/40 transition duration-300">
						<div class="w-full h-full bg-[#0b0f19] rounded-[10px] flex items-center justify-center relative overflow-hidden">
							<!-- Subtle background glow -->
							<div class="absolute inset-0 bg-gradient-to-tr from-amber-500/20 to-transparent"></div>
							<!-- Custom Vault Eye Icon -->
							<svg class="w-6 h-6 text-amber-400 group-hover:scale-110 transition duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<!-- Outer Vault Hexagon -->
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L3 7v10l9 5 9-5V7l-9-5z" class="opacity-90"></path>
								<!-- Inner Keyhole / Aperture Core -->
								<circle cx="12" cy="11" r="2.5" fill="currentColor" class="text-amber-400"></circle>
								<path stroke-linecap="round" stroke-width="2" d="M12 13.5v3.5" class="text-amber-400"></path>
							</svg>
						</div>
					</div>
					<div>
						<div class="flex items-center">
							<span class="text-xl sm:text-2xl font-black text-white tracking-tight font-sans">
								CURIO
							</span>
							<span class="text-xl sm:text-2xl font-black bg-gradient-to-r from-amber-400 to-amber-500 bg-clip-text text-transparent tracking-tight font-sans ml-1">
								VAULT
							</span>
							<span class="w-1.5 h-1.5 rounded-full bg-amber-400 ml-1 translate-y-1"></span>
						</div>
						<span class="text-[9px] uppercase font-bold text-slate-400 tracking-[0.2em] block font-mono">
							EXPLORE THE UNSEEN
						</span>
					</div>
				</a>
			</div>

			<!-- Desktop Navigation Links -->
			<nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
				<a
					href="/"
					class={`px-3 py-2 rounded-lg text-xs uppercase font-bold tracking-wider transition ${
						currentPath === '/'
							? 'text-amber-400 bg-amber-950/40 border border-amber-800/40'
							: 'text-slate-300 hover:text-white hover:bg-slate-800/50'
					}`}
				>
					Home
				</a>
				<a
					href="/blog"
					class={`px-3 py-2 rounded-lg text-xs uppercase font-bold tracking-wider transition ${
						currentPath.startsWith('/blog')
							? 'text-amber-400 bg-amber-950/40 border border-amber-800/40'
							: 'text-slate-300 hover:text-white hover:bg-slate-800/50'
					}`}
				>
					All Stories
				</a>
				<a
					href="/about"
					class={`px-3 py-2 rounded-lg text-xs uppercase font-bold tracking-wider transition ${
						currentPath === '/about'
							? 'text-amber-400 bg-amber-950/40 border border-amber-800/40'
							: 'text-slate-300 hover:text-white hover:bg-slate-800/50'
					}`}
				>
					About
				</a>
				<a
					href="/contact"
					class={`px-3 py-2 rounded-lg text-xs uppercase font-bold tracking-wider transition ${
						currentPath === '/contact'
							? 'text-amber-400 bg-amber-950/40 border border-amber-800/40'
							: 'text-slate-300 hover:text-white hover:bg-slate-800/50'
					}`}
				>
					Contact
				</a>
			</nav>

			<!-- Mobile menu toggle -->
			<div class="flex md:hidden items-center">
				<button
					type="button"
					id="mobile-menu-btn"
					class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/60 focus:outline-hidden"
					aria-label="Toggle navigation menu"
				>
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile Menu Panel (Cleaned - No RSS) -->
	<div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-[#0b0f19] px-4 pt-3 pb-5 space-y-2">
		<a href="/" class="block px-3 py-2 rounded-lg text-sm font-bold uppercase tracking-wider text-slate-200 hover:bg-amber-950/40 hover:text-amber-400">
			Home
		</a>
		<a href="/blog" class="block px-3 py-2 rounded-lg text-sm font-bold uppercase tracking-wider text-slate-200 hover:bg-amber-950/40 hover:text-amber-400">
			All Stories & Videos
		</a>
		<a href="/about" class="block px-3 py-2 rounded-lg text-sm font-bold uppercase tracking-wider text-slate-200 hover:bg-amber-950/40 hover:text-amber-400">
			About CurioVault
		</a>
		<a href="/contact" class="block px-3 py-2 rounded-lg text-sm font-bold uppercase tracking-wider text-slate-200 hover:bg-amber-950/40 hover:text-amber-400">
			Contact Us
		</a>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	if (menuBtn && mobileMenu) {
		menuBtn.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});
	}
</script>
