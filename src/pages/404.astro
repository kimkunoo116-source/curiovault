---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`404 - Page Not Found - ${SITE_TITLE}`} description="The page you are looking for does not exist in CurioVault." />
	</head>
	<body class="bg-[#0b0f19] min-h-screen flex flex-col text-slate-200">
		<Header />
		<main class="grow flex items-center justify-center py-20 px-4 text-center">
			<div class="max-w-md mx-auto">
				<div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-amber-500/10 text-amber-400 border border-amber-500/30 text-3xl font-black mb-6">
					404
				</div>
				<h1 class="text-3xl font-black text-white mb-3">Enigma Not Found</h1>
				<p class="text-sm text-slate-400 mb-8 leading-relaxed">
					This curiosity seems to have vanished from the vault or moved to another dimension.
				</p>
				<a
					href="/"
					class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-[#0b0f19] font-bold text-sm shadow-lg shadow-amber-500/20 hover:from-amber-400 hover:to-amber-500 transition duration-300"
				>
					Return to Main Vault &rarr;
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
