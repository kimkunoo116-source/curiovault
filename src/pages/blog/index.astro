---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Complete Story Archive & Video Features - ${SITE_TITLE}`}
			description={`Browse all fascinating stories, bizarre history, and scientific wonders published on ${SITE_TITLE}.`}
		/>
	</head>
	<body class="bg-[#0b0f19] min-h-screen flex flex-col text-slate-200">
		<Header />

		<main class="grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full space-y-8">
			<!-- Page Header -->
			<div class="border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
				<div>
					<span class="text-[11px] font-bold uppercase tracking-wider text-amber-400 bg-amber-950/60 border border-amber-800/50 px-2.5 py-1 rounded-md inline-block mb-2">
						DISCOVERY ARCHIVE
					</span>
					<h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
						All Stories & Video Features
					</h1>
					<p class="text-xs sm:text-sm text-slate-400 mt-2">
						A curated collection of {posts.length} astonishing human stories, bizarre historical facts, and natural wonders.
					</p>
				</div>
			</div>

			<!-- Posts Grid -->
			<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{posts.map((post) => (
					<article class="group bg-[#111827] rounded-2xl border border-slate-800 overflow-hidden shadow-xl hover:border-amber-500/50 transition duration-300 flex flex-col">
						<a href={`/blog/${post.id}/`} class="block aspect-16/10 overflow-hidden bg-black relative">
							{post.data.heroImage && (
								typeof post.data.heroImage === 'string' ? (
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-90 group-hover:opacity-100"
									/>
								) : (
									<Image
										width={500}
										height={312}
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-90 group-hover:opacity-100"
									/>
								)
							)}
							<span class="absolute top-3 left-3 px-2 py-0.5 bg-black/80 backdrop-blur-xs text-amber-400 text-[10px] font-bold rounded-sm border border-slate-700">
								⏱️ {post.data.videoDuration || 'VIDEO'}
							</span>
						</a>

						<div class="p-6 flex flex-col justify-between grow">
							<div>
								<div class="text-[11px] text-slate-400 mb-2 flex items-center gap-2">
									<span class="text-amber-400 uppercase font-bold">{post.data.category}</span>
									<span>&bull;</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2 class="text-lg font-bold text-white group-hover:text-amber-400 transition leading-snug mb-2 line-clamp-2">
									<a href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
								</h2>
								<p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
									{post.data.description}
								</p>
							</div>

							<div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between text-xs">
								<a href={`/blog/${post.id}/`} class="font-bold text-amber-400 group-hover:underline inline-flex items-center gap-1">
									Read Story &rarr;
								</a>
								<span class="text-slate-400 text-[11px]">CurioVault</span>
							</div>
						</div>
					</article>
				))}
			</section>
		</main>

		<Footer />
	</body>
</html>
