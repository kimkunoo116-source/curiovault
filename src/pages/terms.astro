---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Terms of Service - ${SITE_TITLE}`}
			description={`Terms of Service, Content Usage, and Fair Use Guidelines for ${SITE_TITLE}.`}
		/>
	</head>
	<body class="bg-[#0b0f19] min-h-screen flex flex-col text-slate-200">
		<Header />

		<main class="grow max-w-4xl mx-auto px-4 sm:px-6 py-12">
			<!-- Header Section -->
			<div class="mb-10 text-center">
				<span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-400 bg-amber-950/60 border border-amber-800/50 rounded-md mb-3">
					TERMS & GUIDELINES
				</span>
				<h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
					Terms of Service
				</h1>
				<p class="mt-3 text-xs text-slate-400">
					Last Updated: November 24, 2026 &bull; Effective Immediately
				</p>
			</div>

			<!-- Main Content Document -->
			<div class="bg-[#111827] rounded-2xl shadow-xl border border-slate-800 p-6 sm:p-10 space-y-8 text-slate-300 leading-relaxed">
				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						1. Agreement to Terms
					</h2>
					<p>
						By accessing or using <strong>{SITE_TITLE}</strong> (accessible at {SITE_URL}), you agree to be bound by these Terms of Service and all applicable laws and regulations. If you do not agree with any of these terms, you are prohibited from using or accessing this site.
					</p>
				</section>

				<section class="p-6 bg-[#070a12] rounded-xl border border-slate-800">
					<h2 class="text-lg sm:text-xl font-bold text-white mb-3 pb-2 border-b border-slate-800 flex items-center gap-2">
						<span class="text-amber-400">2.</span> Video Content & Fair Use Disclaimer
					</h2>
					<p class="text-sm">
						<strong>{SITE_TITLE}</strong> is an educational and digital storytelling platform. Companion YouTube videos featured throughout our articles are embedded via standard YouTube API/iFrame embed mechanisms from public, authorized creators for commentary, education, and review under the Fair Use doctrine (17 U.S. Code § 107).
					</p>
					<p class="text-xs text-slate-400 mt-2">
						All rights to original video and audio remain with their respective copyright holders.
					</p>
				</section>

				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						3. Intellectual Property Rights
					</h2>
					<p>
						Original articles, editorial curation, custom graphics, and formatting on <strong>{SITE_TITLE}</strong> are the property of CurioVault. You may share excerpts with proper attribution and a direct link back to the original article on our website.
					</p>
				</section>

				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						4. Disclaimer of Liability
					</h2>
					<p>
						The materials on <strong>{SITE_TITLE}</strong> are provided for informational, historical, and entertainment purposes. We strive for accuracy based on historical records, scientific consensus, and verified sources, but make no warranties regarding completeness for specific academic or legal purposes.
					</p>
				</section>

				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						5. Contact Information
					</h2>
					<p>
						For questions regarding these Terms or content inquiries, please contact our team via the <a href="/contact" class="text-amber-400 underline font-semibold">Contact Page</a>.
					</p>
				</section>
			</div>
		</main>

		<Footer />
	</body>
</html>
