---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About CurioVault - ${SITE_TITLE}`}
			description={`Discover the storytelling mission, editorial standards, and curiosity-driven vision behind ${SITE_TITLE}.`}
		/>
	</head>
	<body class="bg-[#0b0f19] min-h-screen flex flex-col text-slate-200">
		<Header />

		<main class="grow max-w-4xl mx-auto px-4 sm:px-6 py-12">
			<!-- Header Section -->
			<div class="mb-10 text-center">
				<span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-400 bg-amber-950/60 border border-amber-800/50 rounded-md mb-3">
					EDITORIAL MANIFESTO
				</span>
				<h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
					About {SITE_TITLE}
				</h1>
				<p class="mt-3 text-base text-slate-400 max-w-2xl mx-auto leading-relaxed">
					Dedicated to uncovering the world's most fascinating untold stories, bizarre historical facts, and mind-blowing natural wonders.
				</p>
			</div>

			<!-- Main Content Card -->
			<div class="bg-[#111827] rounded-2xl shadow-xl border border-slate-800 p-6 sm:p-10 space-y-8 text-slate-300 leading-relaxed">
				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						1. Our Storytelling Mission
					</h2>
					<p>
						Welcome to <strong>{SITE_TITLE}</strong>. In an era of hurried headlines and endless noise, we believe true human curiosity deserves a sanctuary. We explore the extraordinary corners of our world: the forgotten moments of history that sound stranger than fiction, the scientific phenomena that leave researchers speechless, and the inspiring human journeys that remind us how vast our world truly is.
					</p>
					<p class="mt-3">
						Every article on CurioVault is crafted to entertain, educate, and ignite your imagination, pairing rich narrative writing with curated documentary-style video features.
					</p>
				</section>

				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						2. What We Explore
					</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
						<div class="p-4 rounded-xl bg-[#0d121d] border border-slate-800">
							<h3 class="font-bold text-amber-400 mb-1 text-sm">📜 Bizarre History</h3>
							<p class="text-slate-400">Untold historical events, eccentric historical figures, and baffling ancient archaeological discoveries.</p>
						</div>
						<div class="p-4 rounded-xl bg-[#0d121d] border border-slate-800">
							<h3 class="font-bold text-amber-400 mb-1 text-sm">🌍 Earth & Cosmic Wonders</h3>
							<p class="text-slate-400">Extreme natural phenomena, deep-sea mysteries, astronomical anomalies, and unexplored frontiers.</p>
						</div>
						<div class="p-4 rounded-xl bg-[#0d121d] border border-slate-800">
							<h3 class="font-bold text-amber-400 mb-1 text-sm">💡 Science & Human Feats</h3>
							<p class="text-slate-400">Breakthrough innovations, mind-bending scientific quirks, and extraordinary tales of human perseverance.</p>
						</div>
						<div class="p-4 rounded-xl bg-[#0d121d] border border-slate-800">
							<h3 class="font-bold text-amber-400 mb-1 text-sm">🧭 Lost Expeditions</h3>
							<p class="text-slate-400">Legendary voyages of discovery, forgotten desert cities, and the puzzles explorers left behind.</p>
						</div>
					</div>
				</section>

				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						3. Editorial Integrity & Fact-Checking
					</h2>
					<ul class="list-disc pl-6 space-y-2 text-slate-300 text-sm">
						<li><strong>Thorough Research:</strong> We cross-reference historical archives, scientific journals, academic papers, and museum records.</li>
						<li><strong>Respectful Storytelling:</strong> We celebrate human curiosity while ensuring cultural accuracy, sensitivity, and respect.</li>
						<li><strong>Fair Use Video Curation:</strong> All companion video materials are embedded directly via official creator channels under Fair Use standards for commentary and education.</li>
					</ul>
				</section>

				<section>
					<h2 class="text-xl sm:text-2xl font-bold text-white mb-3 pb-2 border-b border-slate-800">
						4. Connect With Our Editorial Desk
					</h2>
					<p>
						Have a fascinating historical mystery or an incredible story we should feature? Reach out anytime through our <a href="/contact" class="text-amber-400 hover:underline font-semibold">Contact Page</a>.
					</p>
				</section>
			</div>
		</main>

		<Footer />
	</body>
</html>
